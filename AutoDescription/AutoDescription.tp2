BACKUP ~AutoDescription/backup~
AUTHOR ~Selphira (https://www.baldursgateworld.fr/memberlist.php?mode=viewprofile&u=5323)~

VERSION ~0.9.38~

AUTO_EVAL_STRINGS

ALWAYS
	OUTER_PATCH ~~ BEGIN
		PATCH_INCLUDE ~%MOD_FOLDER%/settings-default.ini~
	END

	ACTION_IF FILE_EXISTS ~%MOD_FOLDER%/settings.ini~ BEGIN
		OUTER_PATCH ~~ BEGIN
			PATCH_INCLUDE ~%MOD_FOLDER%/settings.ini~
		END
	END

    // description.tra est en UTF-8 : converti en Windows-1252 sur les jeux classiques, laissé tel
    // quel sur EE. convert_array limite la conversion à ce fichier ; setup.tra (UTF-8) n'est jamais
    // converti.
    ACTION_DEFINE_ARRAY convert_tra BEGIN ~description~ END
    LAF HANDLE_CHARSETS
        INT_VAR
            infer_charsets = 1
            from_utf8 = 1
        STR_VAR
            default_language = ~french~
            tra_path = ~%MOD_FOLDER%/tra~
            out_path = ~weidu_external/Lang/AutoDescription~
            convert_array = convert_tra
            reload_array = convert_tra
    END

    OUTER_SPRINT BGFORGE_LIB_DIR "%MOD_FOLDER%/lib/bgforge"
	OUTER_SPRINT CACHE_FOLDER ~weidu_external/AutoDescription/cache~
    INCLUDE ~%BGFORGE_LIB_DIR%/main.tpa~
    INCLUDE ~%MOD_FOLDER%/lib/always.tpa~
END

LANGUAGE ~Francais~ ~french~
         ~%MOD_FOLDER%/tra/french/setup.tra~
         ~%MOD_FOLDER%/tra/french/description.tra~

LANGUAGE ~English (Beta)~ ~english~
         ~%MOD_FOLDER%/tra/french/setup.tra~
         ~%MOD_FOLDER%/tra/french/description.tra~
         ~%MOD_FOLDER%/tra/english/setup.tra~
         ~%MOD_FOLDER%/tra/english/description.tra~

BEGIN @10 DESIGNATED 10
SILENT
LAF ad_install_init STR_VAR type = ~items~ mod = ~all~ RET log_name END
LAM ad_install_all_items
LAM ad_install_close

BEGIN @15 DESIGNATED 15
SILENT
LAF ad_install_init STR_VAR type = ~spells~ mod = ~all~ RET log_name END
LAM ad_install_all_spells
LAM ad_install_close

BEGIN @20 DESIGNATED 20

PRINT @201
ACTION_READLN directory
OUTER_WHILE NOT(DIRECTORY_EXISTS ~%directory%~) BEGIN
	ACTION_IF IS_AN_INT ~%directory%~ AND ~%directory%~ == 0 BEGIN
		ABORT ~~
	END
	PRINT @202
	ACTION_READLN directory
END
ACTION_DEFINE_ARRAY mod_files BEGIN END
LAF ad_mod_files STR_VAR directory = EVAL ~%directory%~ extension = ~itm~ RET_ARRAY mod_files = files END
SILENT
LAF ad_install_init STR_VAR type = ~items~ mod = ~%directory%~ RET log_name END
LAM ad_init_statistics
ACTION_PHP_EACH mod_files AS mod_file => _ BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%mod_file%~ BEGIN
		COPY_EXISTING ~%mod_file%~ ~override~
			LPM ad_install_item
		BUT_ONLY_IF_IT_CHANGES
	END
END
LAM ad_install_close

BEGIN @25 DESIGNATED 25

PRINT @201
ACTION_READLN directory
OUTER_WHILE NOT(DIRECTORY_EXISTS ~%directory%~) BEGIN
	ACTION_IF IS_AN_INT ~%directory%~ AND ~%directory%~ == 0 BEGIN
		ABORT ~~
	END
	PRINT @202
	ACTION_READLN directory
END
ACTION_DEFINE_ARRAY mod_files BEGIN END
LAF ad_mod_files STR_VAR directory = EVAL ~%directory%~ extension = ~spl~ RET_ARRAY mod_files = files END
SILENT
LAF ad_install_init STR_VAR type = ~spells~ mod = ~%directory%~ RET log_name END
LAM ad_init_statistics
ACTION_PHP_EACH mod_files AS mod_file => _ BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%mod_file%~ BEGIN
		COPY_EXISTING ~%mod_file%~ ~override~
			LPM ad_install_spell
		BUT_ONLY_IF_IT_CHANGES
	END
END
LAM ad_install_close