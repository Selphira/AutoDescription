// Catalogue des opcodes (2da/opcodes.2da), une ligne par opcode des jeux BG :
// - BG2, EE : 1 si l'opcode existe dans le moteur (IESDP) ; BG2 vaut pour BG2/ToB et BGT ;
// - STATUS : DESCRIBED (décrit par une macro ad_op_<N>_*), IGNORED (rien à décrire, ex. effet
//   visuel), TODO (pas encore pris en charge : la ressource n'est pas couverte) ;
// - DICE : sens des champs « dés » de l'effet (IESDP) : LEVEL (niveau maximum / minimum de la
//   cible), DICE (vrais dés), DICE_IF_P2_1_EE (dés si parameter2 = 1 sur EE, sinon niveaux) ;
// - SORT : rang d'affichage des lignes de l'opcode dans une section (le plus petit d'abord) ;
// - DURATION : durée d'un effet d'en-tête (anciennes listes opcodes_ignore_duration,
//   opcodes_cant_be_permanent, opcodes_cant_be_permanent_after_death) : SHOWN (affichée), IGNORED
//   (jamais affichée, ni comptée dans la durée commune d'une potion), HIDDEN (jamais affichée mais
//   comptée), NOT_PERMANENT (affichée, sauf « de manière permanente »), NOT_AFTER_DEATH (affichée ;
//   un effet qui persiste après la mort est seulement dit permanent).
// Un opcode absent du catalogue ou inexistant dans le jeu courant est « inconnu » : il n'est pas
// décrit et il est journalisé, comme l'effet qu'ignore le moteur du jeu.
OUTER_SET ad_catalog_column = IS_EE ? 2 : 1
COPY - ~%MOD_FOLDER%/2da/opcodes.2da~ ~override~
	READ_2DA_ENTRIES_NOW ad_catalog 8
	FOR (ad_row = 0; ad_row < ad_catalog; ++ad_row) BEGIN
		READ_2DA_ENTRY_FORMER ad_catalog ad_row 0 ad_opcode
		READ_2DA_ENTRY_FORMER ad_catalog ad_row ad_catalog_column ad_available
		READ_2DA_ENTRY_FORMER ad_catalog ad_row 3 ad_status
		READ_2DA_ENTRY_FORMER ad_catalog ad_row 4 ad_dice
		READ_2DA_ENTRY_FORMER ad_catalog ad_row 5 ad_sort
		READ_2DA_ENTRY_FORMER ad_catalog ad_row 6 ad_duration
		SET $AD_OPCODE_AVAILABLE(~%ad_opcode%~) = ad_available
		SPRINT $AD_OPCODE_STATUS(~%ad_opcode%~) ~%ad_status%~
		SPRINT $AD_OPCODE_DICE(~%ad_opcode%~) ~%ad_dice%~
		SET $AD_OPCODE_SORT(~%ad_opcode%~) = ad_sort
		SPRINT $AD_OPCODE_DURATION(~%ad_opcode%~) ~%ad_duration%~
	END

// Opcodes dont les lignes réunissent des effets sans tenir compte de leur portée (new-lib/normalize.tpp,
// fx_scope) : leurs effets d'en-tête ne sont pas encore pris en charge (ad_application_support).
ACTION_DEFINE_ASSOCIATIVE_ARRAY AD_OPCODES_EQUIPPED_ONLY BEGIN
	42  => 1 // emplacements de sorts profanes
	62  => 1 // emplacements de sorts divins
	144 => 1 // boutons désactivés
	145 => 1 // lancement de sorts désactivé
	206 => 1 // protections contre des sorts
END

// Types de jet de sauvegarde d'un effet (bits 0-4, IESDP) => opcode dont le libellé 2OOO0000 les
// nomme (« contre les sorts »), dans l'ordre de l'ancien saveType_to_strref.
ACTION_DEFINE_ASSOCIATIVE_ARRAY AD_SAVE_TYPES BEGIN
	1  => 37 // sorts
	2  => 36 // souffles
	4  => 33 // paralysie, mort et poisons
	8  => 34 // baguettes, sceptres et bâtons
	16 => 35 // pétrification et métamorphose
END

// Attaques par round de l'opcode 1, en dixièmes, selon parameter1 (ancien opcode_1_values) : 0 à 5
// attaques, puis 6 à 10 pour ½, 1½, 2½, 3½, 4½.
ACTION_DEFINE_ASSOCIATIVE_ARRAY AD_ATTACKS_PER_ROUND BEGIN
	0 => 0
	1 => 10
	2 => 20
	3 => 30
	4 => 40
	5 => 50
	6 => 5
	7 => 15
	8 => 25
	9 => 35
	10 => 45
END

// Opcodes dont le jet de sauvegarde peut ignorer les images miroir (bit 24, EE), ou la difficulté
