ACTION_DEFINE_ASSOCIATIVE_ARRAY AD_SAVE_MIRROR_OPCODES BEGIN
	12 => 1 // dégâts
	25 => 1 // poison
END
ACTION_DEFINE_ASSOCIATIVE_ARRAY AD_SAVE_DIFFICULTY_OPCODES BEGIN
	12 => 1 // dégâts
END

