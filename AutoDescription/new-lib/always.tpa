// Nouveau moteur : aucun code commun avec lib/ ni sfo/,
// ni lecture de leurs variables globales ; tools/static_checks.py vérifie cette séparation.
ACTION_IF !VARIABLE_IS_SET AD_ENGINE_LOADED BEGIN
	OUTER_SET AD_ENGINE_LOADED = 1

	// Champs d'un effet du magasin (new-lib/effects.tpp), dans l'ordre des journaux.
	ACTION_DEFINE_ARRAY AD_FX_FIELDS BEGIN
		~block~ ~header~ ~position~ ~opcode~ ~target~ ~power~ ~parameter1~ ~parameter2~ ~timing~
		~resistance~ ~duration~ ~probability1~ ~probability2~ ~resource~ ~dice_count~ ~dice_sides~
		~save_type~ ~save_bonus~ ~special~
	END

	INCLUDE ~%MOD_FOLDER%/new-lib/effects.tpp~
	INCLUDE ~%MOD_FOLDER%/new-lib/log.tpp~
	INCLUDE ~%MOD_FOLDER%/new-lib/item.tpp~
	INCLUDE ~%MOD_FOLDER%/new-lib/spell.tpp~
END
