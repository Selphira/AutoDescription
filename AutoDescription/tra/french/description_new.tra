/*
 * Chaînes du nouveau moteur (new-lib/). Fichier en UTF-8 sans BOM ; uniquement des caractères
 * représentables en Windows-1252 (convertis pour les jeux classiques par HANDLE_CHARSETS).
 * Identifiants : 1 000 000-9 999 999 et 20 000 000-39 999 999 uniquement, selon le plan de
 * numérotation (.agents/tra-numbering.md). « reprise de @n » : texte identique à celui de
 * description.tra, vérifié par tools/static_checks.py.
 */

// Mise en forme : ponctuation et séparateurs (1 000 000-1 099 999)
@1000000 = ~
~ // reprise de @10000
@1000001 = ~ : ~ // reprise de @10001
@1000002 = ~ ; ~ // reprise de @10004
@1000003 = ~ %~ // reprise de @10022
@1000004 = ~et~ // reprise de @100021
@1000005 = ~ », « ~ // reprise de @10020
@1000006 = ~ » %and% « ~ // reprise de @10021
@1000007 = ~ou~ // reprise de @100004
@1000008 = ~les~ // reprise de @100020

// Mise en forme : distances, 1 100 000 + pluriel + 2 × demi-unité ; le .tra choisit l'unité (%distance_units% mètres entiers, %distance_feet% pieds) (1 100 000-1 100 099)
@1100000 = ~%distance_units% mètre~
@1100001 = ~%distance_units% mètres~
@1100002 = ~%distance_units%,5 mètre~
@1100003 = ~%distance_units%,5 mètres~

// Mise en forme : distances en deçà d'un mètre, écrites comme l'ancien feets_to_meters (nombre de décimètres en français, de pieds en anglais) : 1 100 010 + pluriel
@1100010 = ~%distance_decimeters% mètre~
@1100011 = ~%distance_decimeters% mètres~

// Mise en forme : valeurs (1 200 000-1 200 099)
@1200000 = ~%name%%AD_COLON%%value%~ // reprise de @100001
@1200001 = ~+%value%~ // reprise de @10003
@1200002 = ~Passe à %value%~ // reprise de @10010
@1200003 = ~%value%%PERCENT%~ // reprise de @10002
@1200004 = ~Multiplié par %value%~ // reprise de @10006
@1200005 = ~%diceCount%d%diceSides%~ // reprise de @10014
@1200006 = ~Fixée à %value%~
@1200010 = ~%name%%AD_COLON%%value%~ // reprise de @100001
@1200011 = ~%name% %ofTheTarget%%AD_COLON%%value%~ // reprise de @100007

// Mise en forme : phrases des modificateurs simples, séries de 10 (+0 soi, +1 cible…) : 0110 augmentation, 0120 réduction (1 210 000-1 210 999)
@1210111 = ~Augmente de %value% %theStatistic% %ofTheTarget%~ // reprise de @102286
@1210112 = ~d'augmenter de %value% %theStatistic% %ofTheTarget%~ // reprise de @102544
@1210113 = ~d'augmenter de %value% %theStatistic% %ofTheTarget%~ // reprise de @102544
@1210121 = ~Réduit de %value% %theStatistic% %ofTheTarget%~ // reprise de @102285
@1210122 = ~de réduire de %value% %theStatistic% %ofTheTarget%~ // reprise de @102543
@1210123 = ~de réduire de %value% %theStatistic% %ofTheTarget%~ // reprise de @102543
@1210131 = ~Porte à %value% %theStatistic% %ofTheTarget%~ // reprise de @102287
@1210132 = ~de passer à %value% %theStatistic% %ofTheTarget%~ // reprise de @102545
@1210133 = ~de passer à %value% %theStatistic% %ofTheTarget%~ // reprise de @102545
@1210141 = ~Multiplie par %value% %theStatistic% %ofTheTarget%~ // reprise de @102288
@1210142 = ~de multiplier par %value% %theStatistic% %ofTheTarget%~ // reprise de @102546
@1210143 = ~de multiplier par %value% %theStatistic% %ofTheTarget%~ // reprise de @102546

