/*
 * Chaînes du nouveau moteur (new-lib/). Fichier en UTF-8 sans BOM ; uniquement des caractères
 * représentables en Windows-1252 (convertis pour les jeux classiques par HANDLE_CHARSETS).
 * Identifiants : 1 000 000-9 999 999 et 20 000 000-39 999 999 uniquement, selon le plan de
 * numérotation (.agents/tra-numbering.md). « reprise de @n » : texte identique à celui de
 * description.tra, vérifié par tools/static_checks.py.
 */

// Mise en forme : ponctuation et séparateurs (1 000 000-1 099 999)
@1000000 = ~
~ // reprise de @10000
@1000001 = ~ : ~ // reprise de @10001
@1000002 = ~ ; ~ // reprise de @10004
@1000003 = ~ %~ // reprise de @10022
@1000004 = ~et~ // reprise de @100021
@1000005 = ~ », « ~ // reprise de @10020
@1000006 = ~ » %and% « ~ // reprise de @10021

// Mise en forme : valeurs (1 200 000-1 200 099)
@1200000 = ~%name%%AD_COLON%%value%~ // reprise de @100001
@1200001 = ~+%value%~ // reprise de @10003
@1200002 = ~Passe à %value%~ // reprise de @10010
@1200003 = ~%value%%PERCENT%~ // reprise de @10002
@1200004 = ~Multiplié par %value%~ // reprise de @10006

// Mise en forme : titres de sections (1 300 000-1 300 099)
@1300000 = ~PARAMÈTRES~ // reprise de @100003
@1300001 = ~Capacités d'équipement~ // reprise de @100010
@1300002 = ~Nécessite~ // reprise de @101032

// Mise en forme : expressions régulières d'analyse des descriptions d'origine (1 900 000-1 900 099)
@1900000 = ~^[ %TAB%]*\(CARACTÉRISTIQUES\|Caractéristiques\|CARACTERISTIQUES\|PARAMETRES\|PARAMÈTRES\|STATISTIQUES\|CAPACITES SPECIALES\|CAPACITES DE COMBAT\|Capacité de combat\|Capacités spéciales\|Capacité d'équipement\|Capacités d'équipement\|Capacités de charge\|Capacités de combat\|Poids\|Weight\|Statistics\|EIGENSCHAFTEN\|STATISTICHE\|Caratteristiche\|SPEZIELLE EIGENSCHAFTEN\)+\(.*[%MNL%%LNL%%WNL%]*\)*~ // reprise de @10008

// Jets de sauvegarde et résistances : libellés (5 000 000-5 000 099)
@5000000 = ~Jets de sauvegarde~ // reprise de @102034
@5000001 = ~Immunité %resistName%~ // reprise de @102547

// Objets : lignes fixes des capacités d'équipement (6 000 000-6 000 099)
@6000000 = ~Maudit%AD_COLON%Ne peut être ôté qu'à l'aide d'un sort de Délivrance de la malédiction~ // reprise de @102126
@6000001 = ~Protection contre les coups critiques~ // reprise de @102679

// Objets : nécessite, poids (6 200 000-6 200 099)
@6200000 = ~%value% en %attribute%~ // reprise de @100019
@6200001 = ~Poids~ // reprise de @100002

// Sorts : noms imposés par ressource (7 100 000-7 100 099)
@7100000 = ~~ // reprise de @102150
@7100001 = ~Pétrification~ // reprise de @102355
@7100002 = ~Transmutation de la pierre en chair~ // reprise de @102356
@7100003 = ~Emprisonnement~ // reprise de @102469
@7100004 = ~Enchevêtrement~ // reprise de @102468
@7100005 = ~Lame noire du désastre~ // reprise de @102470

