@2001012 = ~aux créatures hostiles~ // reprise de @102721
@2001020 = ~les créatures alliées~ // reprise de @102702
@2001021 = ~des créatures alliées~ // reprise de @102712
@2001022 = ~aux créatures alliées~ // reprise de @102722
@2001100 = ~%target% dans un rayon de %range%~ // reprise de @102800
@2001102 = ~%target% dans un cône de %range% sur un arc de %angle%°~ // reprise de @102802

// Type de créature visé par un effet d'un 177 : 0000-0005 liaisons de la liste (« les », « et les », « des »…), 0010-0012 cible (« les %targetType% », « des… », « aux… »), 0020 « contre », 0030 « uniquement pour » (2 002 000-2 002 099)
@2002000 = ~les~ // reprise de @11770200
@2002001 = ~et les~ // reprise de @11770201
@2002002 = ~des~ // reprise de @11770202
@2002003 = ~et des~ // reprise de @11770203
@2002004 = ~aux~ // reprise de @11770204
@2002005 = ~et aux~ // reprise de @11770205
@2002010 = ~les %targetType%~ // reprise de @102384
@2002011 = ~des %targetType%~ // reprise de @102385
@2002012 = ~aux %targetType%~ // reprise de @102386
@2002020 = ~contre les %targetType%~ // reprise de @102387
@2002030 = ~uniquement pour les %targetType%~ // reprise de @11770001

