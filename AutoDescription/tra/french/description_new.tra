/*
 * Chaînes du nouveau moteur (new-lib/). Fichier en UTF-8 sans BOM ; uniquement des caractères
 * représentables en Windows-1252 (convertis pour les jeux classiques par HANDLE_CHARSETS).
 * Identifiants : 1 000 000-9 999 999 et 20 000 000-39 999 999 uniquement, selon le plan de
 * numérotation (.agents/tra-numbering.md). « reprise de @n » : texte identique à celui de
 * description.tra, vérifié par tools/static_checks.py.
 */

// Mise en forme : ponctuation et séparateurs (1 000 000-1 099 999)
@1000000 = ~
~ // reprise de @10000
@1000001 = ~ : ~ // reprise de @10001
@1000002 = ~ ; ~ // reprise de @10004
@1000003 = ~ %~ // reprise de @10022

// Mise en forme : valeurs (1 200 000-1 200 099)
@1200000 = ~%name%%AD_COLON%%value%~ // reprise de @100001
@1200001 = ~+%value%~ // reprise de @10003
@1200002 = ~Passe à %value%~ // reprise de @10010
@1200003 = ~%value%%PERCENT%~ // reprise de @10002
@1200004 = ~Multiplié par %value%~ // reprise de @10006

// Mise en forme : titres de sections (1 300 000-1 300 099)
@1300000 = ~PARAMÈTRES~ // reprise de @100003
@1300001 = ~Capacités d'équipement~ // reprise de @100010
@1300002 = ~Nécessite~ // reprise de @101032

// Mise en forme : expressions régulières d'analyse des descriptions d'origine (1 900 000-1 900 099)
@1900000 = ~^[ %TAB%]*\(CARACTÉRISTIQUES\|Caractéristiques\|CARACTERISTIQUES\|PARAMETRES\|PARAMÈTRES\|STATISTIQUES\|CAPACITES SPECIALES\|CAPACITES DE COMBAT\|Capacité de combat\|Capacités spéciales\|Capacité d'équipement\|Capacités d'équipement\|Capacités de charge\|Capacités de combat\|Poids\|Weight\|Statistics\|EIGENSCHAFTEN\|STATISTICHE\|Caratteristiche\|SPEZIELLE EIGENSCHAFTEN\)+\(.*[%MNL%%LNL%%WNL%]*\)*~ // reprise de @10008

// Jets de sauvegarde et résistances : libellés (5 000 000-5 000 099)
@5000000 = ~Jets de sauvegarde~ // reprise de @102034
@5000001 = ~Immunité %resistName%~ // reprise de @102547

// Objets : lignes fixes des capacités d'équipement (6 000 000-6 000 099)
@6000000 = ~Maudit%AD_COLON%Ne peut être ôté qu'à l'aide d'un sort de Délivrance de la malédiction~ // reprise de @102126
@6000001 = ~Protection contre les coups critiques~ // reprise de @102679

// Objets : nécessite, poids (6 200 000-6 200 099)
@6200000 = ~%value% en %attribute%~ // reprise de @100019
@6200001 = ~Poids~ // reprise de @100002

// Listes indexées : noms des statistiques, 8 000 000 + valeur de stats.ids (8 000 000-8 009 999)
@8000007 = ~TAC0~ // reprise de @10540001
@8000025 = ~Connaissances~ // reprise de @10210001
@8000030 = ~Fatigue~ // reprise de @10930001
@8000031 = ~Ébriété~ // reprise de @10940001
@8000032 = ~Chance~ // reprise de @10220001
@8000033 = ~Pistage~ // reprise de @10950001
@8000034 = ~Niveau~ // reprise de @10960001
@8000036 = ~Force~ // reprise de @10440001
@8000038 = ~Intelligence~ // reprise de @10190001
@8000039 = ~Sagesse~ // reprise de @10490001
@8000040 = ~Dextérité~ // reprise de @10150001
@8000041 = ~Constitution~ // reprise de @10100001
@8000042 = ~Charisme~ // reprise de @10060001
@8000044 = ~Expérience~ // reprise de @11040001

// Opcode 0, classe d'armure : libellés (20 000 000-20 000 099)
@20000000 = ~Classe d'armure~ // reprise de @10000099
@20000001 = ~Classe d'armure de base~ // reprise de @10000100
@20000002 = ~Bonus de %value%~ // reprise de @10000101
@20000003 = ~Malus de %value%~ // reprise de @10000102

// Opcode 0 : types d'attaque, 20 001 000 + masque de parameter2 (20 001 000-20 001 015)
@20001001 = ~contre les armes contondantes~ // reprise de @10000001
@20001002 = ~contre les projectiles~ // reprise de @10000002
@20001003 = ~contre les armes contondantes et les projectiles~ // reprise de @10000003
@20001004 = ~contre les armes perforantes~ // reprise de @10000004
@20001005 = ~contre les armes contondantes et perforantes~ // reprise de @10000005
@20001006 = ~contre les armes perforantes et les projectiles~ // reprise de @10000006
@20001007 = ~contre les armes contondantes, perforantes et les projectiles~ // reprise de @10000007
@20001008 = ~contre les armes tranchantes~ // reprise de @10000008
@20001009 = ~contre les armes contondantes et tranchantes~ // reprise de @10000009
@20001010 = ~contre les armes tranchantes et les projectiles~ // reprise de @10000010
@20001011 = ~contre les armes contondantes, tranchantes et les projectiles~ // reprise de @10000011
@20001012 = ~contre les armes tranchantes et perforantes~ // reprise de @10000012
@20001013 = ~contre les armes contondantes, tranchantes et perforantes~ // reprise de @10000013
@20001014 = ~contre les armes tranchantes, perforantes et les projectiles~ // reprise de @10000014

