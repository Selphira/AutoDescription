@2001022 = ~aux créatures alliées~
@2001100 = ~%target% dans un rayon de %range%~
@2001101 = ~%target% dans un rayon de %range% autour %ofTheTarget%~
@2001102 = ~%target% dans un cône de %range% sur un arc de %angle%°~
@2001103 = ~%main_target% et %target% dans un rayon de %range%~

// Type de créature visé par un effet d'un 177 : 0000-0005 liaisons de la liste (« les », « et les », « des »…), 0010-0012 cible (« les %targetType% », « des… », « aux… »), 0020 « contre », 0030 « uniquement pour » (2 002 000-2 002 099)
@2002000 = ~les~
@2002001 = ~et les~
@2002002 = ~des~
@2002003 = ~et des~
@2002004 = ~aux~
@2002005 = ~et aux~
@2002006 = ~et~
@2002010 = ~les %targetType%~
@2002011 = ~des %targetType%~
@2002012 = ~aux %targetType%~
@2002020 = ~contre les %targetType%~
@2002030 = ~uniquement pour les %targetType%~
@2002031 = ~uniquement pour le kit %targetType%~
@2002032 = ~uniquement pour les kits %targetType%~
@2002040 = ~%outerType% qui sont aussi des %innerType%~
@2002050 = ~mages monoclassés et multiclassés~
@2002051 = ~voleurs monoclassés et multiclassés~

// Restriction de niveau de la cible (ancien add_target_level) : 0 un niveau, 1 au plus, 2 au moins, 3 de… à… (2 003 000-2 003 009)
@2003000 = ~%target% (de niveau %levelMin%)~
@2003001 = ~%target% (de niveau %levelMax% ou inférieur)~
@2003002 = ~%target% (de niveau %levelMin% ou supérieur)~
@2003003 = ~%target% (de niveau %levelMin% à %levelMax%)~
@2003004 = ~uniquement au niveau %levelMin%~
@2003005 = ~uniquement jusqu'au niveau %levelMax%~
@2003006 = ~uniquement à partir du niveau %levelMin%~
