/*
 * Chaînes du moteur (lib/). Fichier en UTF-8 sans BOM ; uniquement des caractères
 * représentables en Windows-1252 (convertis pour les jeux classiques par HANDLE_CHARSETS).
 * Identifiants : 1 000 000-9 999 999 et 20 000 000-39 999 999 uniquement, selon le plan de
 * numérotation (.agents/tra-numbering.md).
 */

// Mise en forme : ponctuation et séparateurs (1 000 000-1 099 999)
@1000000 = ~
~
@1000001 = ~: ~
@1000002 = ~; ~
@1000003 = ~%~
@1000004 = ~and~
@1000005 = ~, ~
@1000006 = ~ %and% ~
@1000007 = ~or~
@1000008 = ~~

// Mise en forme : distances, 1 100 000 + pluriel + 2 × demi-unité ; le .tra choisit l'unité (%distance_units% mètres entiers, %distance_feet% pieds) (1 100 000-1 100 099)
@1100000 = ~%distance_feet% feet~
@1100001 = ~%distance_feet% feet~
@1100002 = ~%distance_feet% feet~
@1100003 = ~%distance_feet% feet~

// Mise en forme : distances en deçà d'un mètre, écrites comme l'ancien feets_to_meters (nombre de décimètres en français, de pieds en anglais) : 1 100 010 + pluriel
@1100010 = ~%distance_feet% feet~
@1100011 = ~%distance_feet% feet~

// Mise en forme : valeurs (1 200 000-1 200 099)
@1200000 = ~%name%%AD_COLON%%value%~
@1200001 = ~+%value%~
@1200002 = ~Set to %value%~
@1200003 = ~%value%%~
@1200004 = ~Multiplied by %value%~
@1200005 = ~%diceCount%d%diceSides%~
@1200006 = ~Fixed at %value%~
@1200010 = ~%name%%AD_COLON%%value%~
@1200011 = ~%name% %ofTheTarget%%AD_COLON%%value%~

// Mise en forme : phrases des modificateurs simples, séries de 10 (+0 soi, +1 cible…) : 0110 augmentation, 0120 réduction (1 210 000-1 210 999)
@1210111 = ~Increases %theStatistic% %ofTheTarget% by %value%~
@1210112 = ~to increase %theStatistic% %ofTheTarget% by %value%~
@1210113 = ~to increase %theStatistic% %ofTheTarget% by %value%~
@1210121 = ~Reduces %theStatistic% %ofTheTarget% by %value%~
@1210122 = ~to reduce %theStatistic% %ofTheTarget% by %value%~
@1210123 = ~to reduce %theStatistic% %ofTheTarget% by %value%~
@1210131 = ~Sets %theStatistic% %ofTheTarget% to %value%~
@1210132 = ~to set %theStatistic% %ofTheTarget% to %value%~
@1210133 = ~to set %theStatistic% %ofTheTarget% to %value%~
@1210141 = ~Multiplies %theStatistic% %ofTheTarget% by %value%~
@1210142 = ~to multiply %theStatistic% %ofTheTarget% by %value%~
@1210143 = ~to multiply %theStatistic% %ofTheTarget% by %value%~

// Mise en forme : titres de sections (1 300 000-1 300 099)
@1300000 = ~STATISTICS~
@1300001 = ~Equipped abilities~
@1300002 = ~Requires~
@1300003 = ~Combat abilities~
@1300004 = ~Charge abilities~
@1300005 = ~Charge ability~
@1300006 = ~Ability %abilityNumber%~
@1300007 = ~Casting ability~
@1300008 = ~Spell ability~
@1300009 = ~Casting abilities~
@1300010 = ~Spell abilities~

// Mise en forme : expressions régulières d'analyse des descriptions d'origine (1 900 000-1 900 099)
@1900000 = ~^[ %TAB%]*\(CARACTÉRISTIQUES\|Caractéristiques\|CARACTERISTIQUES\|PARAMETRES\|PARAMÈTRES\|STATISTIQUES\|CAPACITES SPECIALES\|CAPACITES DE COMBAT\|Capacité de combat\|Capacités spéciales\|Capacité d'équipement\|Capacités d'équipement\|Capacités de charge\|Capacités de combat\|Poids\|Weight\|Statistics\|EIGENSCHAFTEN\|STATISTICHE\|Caratteristiche\|SPEZIELLE EIGENSCHAFTEN\)+\(.*[%MNL%%LNL%%WNL%]*\)*~
@1900001 = ~\(Saving Throw\)+~

// Cibles, 2 000 000 + 10 × cible effective de l'effet + forme (0 sujet, 1 « de… », 2 « à… ») (2 000 000-2 000 099)
@2000020 = ~the target~
@2000021 = ~of the target~
@2000022 = ~to the target~
@2000030 = ~party members~
@2000031 = ~of party members~
@2000032 = ~to party members~
@2000040 = ~creatures in the area of effect~
@2000041 = ~of creatures in the area of effect~
@2000042 = ~to creatures in the area of effect~
@2000050 = ~creatures outside the party~
@2000051 = ~of creatures outside the party~
@2000052 = ~to creatures outside the party~
@2000060 = ~party members~
@2000061 = ~of party members~
@2000062 = ~to party members~
@2000080 = ~other creatures in the area of effect~
@2000081 = ~of other creatures in the area of effect~
@2000082 = ~to other creatures in the area of effect~
@2000100 = ~the wearer~
@2000101 = ~of the wearer~
@2000102 = ~to the wearer~
@2000110 = ~the drinker~
@2000111 = ~of the drinker~
@2000112 = ~to the drinker~
@2000120 = ~the caster~
@2000121 = ~of the caster~
@2000122 = ~to the caster~

// Cibles d'une zone nommées d'après le projectile : 2 001 000 + 10 × créatures visées (0 toutes, 1 hostiles, 2 alliées) + forme (0 sujet, 1 « de… », 2 « à… ») ; 2 001 100 zone, 2 001 102 cône (2 001 000-2 001 199)
@2001000 = ~creatures~
@2001001 = ~of creatures~
@2001002 = ~to creatures~
@2001010 = ~enemies~
@2001011 = ~of enemies~
@2001012 = ~to enemies~
@2001020 = ~allies~
@2001021 = ~of allies~
@2001022 = ~to allies~
@2001100 = ~%target% within a radius of %range%~
@2001101 = ~%target% within %range% %ofTheTarget%~
@2001102 = ~%target% within a %range% cone on a %angle%° arc~
@2001103 = ~%main_target% and %target% within a radius of %range%~

// Type de créature visé par un effet d'un 177 : 0000-0005 liaisons de la liste (« les », « et les », « des »…), 0010-0012 cible (« les %targetType% », « des… », « aux… »), 0020 « contre », 0030 « uniquement pour » (2 002 000-2 002 099)
@2002000 = ~~
@2002001 = ~and~
@2002002 = ~of~
@2002003 = ~and of~
@2002004 = ~to~
@2002005 = ~and to~
@2002006 = ~and~
@2002010 = ~%targetType%~
@2002011 = ~of %targetType%~
@2002012 = ~to %targetType%~
@2002020 = ~vs. %targetType%~
@2002030 = ~only for %targetType%~
@2002031 = ~only for the %targetType% kit~
@2002032 = ~only for the %targetType% kits~
@2002040 = ~%outerType% that are also %innerType%~
@2002050 = ~single and multiclassed mages~
@2002051 = ~single and multiclassed thieves~

// Restriction de niveau de la cible (ancien add_target_level) : 0 un niveau, 1 au plus, 2 au moins, 3 de… à… (2 003 000-2 003 009)
@2003000 = ~%target% (of level %levelMin%)~
@2003001 = ~%target% (of level %levelMax% or lower)~
@2003002 = ~%target% (of level %levelMin% or higher)~
@2003003 = ~%target% (from level %levelMin% to %levelMax%)~
@2003004 = ~only at level %levelMin%~
@2003005 = ~only up to level %levelMax%~
@2003006 = ~only from level %levelMin%~
@2003007 = ~only from level %levelMin% to level %levelMax%~

// Durées : formules (3 000 000-3 000 099)
@3000000 = ~for %strDuration%~
@3000001 = ~permanently~
@3000002 = ~permanently (persists after death)~
@3000003 = ~%frequency% for %strDuration%~
@3000004 = ~%frequency% for %strDuration% after %afterStrDuration%~
@3000005 = ~after %strDuration%~

// Durées : progressions selon le niveau (en-tête des sorts)
@3000006 = ~after %strDuration% and for %strDuration%~
@3000007 = ~for less than one second~
@3000010 = ~%baseValue% + %value% at level %level%~
@3000011 = ~%value%/level~
@3000012 = ~%value%/%level% levels~
@3000013 = ~%baseValue% up to level %level%~

// Durées : unités, 3 010 000 + 2 × unité + pluriel ; unités 0 seconde, 1 round, 2 tour, 3 heure, 4 jour (3 010 000-3 010 009)
