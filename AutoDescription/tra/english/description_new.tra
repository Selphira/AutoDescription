@2002020 = ~vs. %targetType%~ // reprise de @102387
@2002030 = ~only for %targetType%~ // reprise de @11770001
@2002031 = ~only for the %targetType% kit~ // reprise de @11770002
@2002032 = ~only for the %targetType% kits~ // reprise de @11770003
@2002040 = ~%outerType% that are also %innerType%~ // reprise de @11770210

