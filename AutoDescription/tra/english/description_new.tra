@3000004 = ~%frequency% for %strDuration% after %afterStrDuration%~ // reprise de @100316
@3000005 = ~after %strDuration%~ // reprise de @100310

// Durées : unités, 3 010 000 + 2 × unité + pluriel ; unités 0 seconde, 1 round, 2 tour, 3 heure, 4 jour (3 010 000-3 010 009)
@3010000 = ~1 second~ // reprise de @100300
@3010001 = ~%amount% seconds~ // reprise de @100301
@3010002 = ~1 round~ // reprise de @100302
@3010003 = ~%amount% rounds~ // reprise de @100303
@3010004 = ~1 turn~ // reprise de @100304
@3010005 = ~%amount% turns~ // reprise de @100305
@3010006 = ~1 hour~ // reprise de @100306
@3010007 = ~%amount% hours~ // reprise de @100307
@3010008 = ~1 day~ // reprise de @100308
@3010009 = ~%amount% days~ // reprise de @100309

// Durées : fréquences, 3 020 000 + 2 × unité + pluriel ; unités de 3 010 000 (3 020 000-3 020 009)
@3020000 = ~every second~
@3020001 = ~every %amount% seconds~
@3020002 = ~every round~
@3020003 = ~every %amount% rounds~
@3020004 = ~every turn~
@3020005 = ~every %amount% turns~
@3020006 = ~every hour~
@3020007 = ~every %amount% hours~
