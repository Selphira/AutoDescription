/*
 * Chaînes du nouveau moteur (new-lib/). Fichier en UTF-8 sans BOM ; uniquement des caractères
 * représentables en Windows-1252 (convertis pour les jeux classiques par HANDLE_CHARSETS).
 * Identifiants : 1 000 000-9 999 999 et 20 000 000-39 999 999 uniquement, selon le plan de
 * numérotation (.agents/tra-numbering.md). « reprise de @n » : texte identique à celui de
 * description.tra, vérifié par tools/static_checks.py.
 */

// Mise en forme : ponctuation et séparateurs (1 000 000-1 099 999)
@1000000 = ~
~ // reprise de @10000
@1000001 = ~: ~ // reprise de @10001
@1000002 = ~; ~ // reprise de @10004
@1000003 = ~%~ // reprise de @10022

// Mise en forme : valeurs (1 200 000-1 200 099)
@1200000 = ~%name%%AD_COLON%%value%~ // reprise de @100001
@1200001 = ~+%value%~ // reprise de @10003
@1200002 = ~Set to %value%~ // reprise de @10010
@1200003 = ~%value%%~ // reprise de @10002

// Mise en forme : titres de sections (1 300 000-1 300 099)
@1300000 = ~STATISTICS~ // reprise de @100003
@1300001 = ~Equipped abilities~ // reprise de @100010
@1300002 = ~Requires~ // reprise de @101032

// Mise en forme : expressions régulières d'analyse des descriptions d'origine (1 900 000-1 900 099)
@1900000 = ~^[ %TAB%]*\(CARACTÉRISTIQUES\|Caractéristiques\|CARACTERISTIQUES\|PARAMETRES\|PARAMÈTRES\|STATISTIQUES\|CAPACITES SPECIALES\|CAPACITES DE COMBAT\|Capacité de combat\|Capacités spéciales\|Capacité d'équipement\|Capacités d'équipement\|Capacités de charge\|Capacités de combat\|Poids\|Weight\|Statistics\|EIGENSCHAFTEN\|STATISTICHE\|Caratteristiche\|SPEZIELLE EIGENSCHAFTEN\)+\(.*[%MNL%%LNL%%WNL%]*\)*~ // reprise de @10008

// Objets : lignes fixes des capacités d'équipement (6 000 000-6 000 099)
@6000000 = ~May only be removed with a Remove Curse spell~ // reprise de @102126
@6000001 = ~Protects against critical hits~ // reprise de @102679

// Objets : nécessite, poids (6 200 000-6 200 099)
@6200000 = ~%value% %attribute%~ // reprise de @100019
@6200001 = ~Weight~ // reprise de @100002

// Listes indexées : noms des statistiques, 8 000 000 + valeur de stats.ids (8 000 000-8 009 999)
@8000034 = ~Level~ // reprise de @10960001
@8000036 = ~Strength~ // reprise de @10440001
@8000038 = ~Intelligence~ // reprise de @10190001
@8000039 = ~Wisdom~ // reprise de @10490001
@8000040 = ~Dexterity~ // reprise de @10150001
@8000041 = ~Constitution~ // reprise de @10100001
@8000042 = ~Charisma~ // reprise de @10060001

// Opcode 0, classe d'armure : libellés (20 000 000-20 000 099)
@20000000 = ~Armor Class~ // reprise de @10000099
@20000001 = ~Base Armor Class~ // reprise de @10000100
@20000002 = ~%value% bonus~ // reprise de @10000101
@20000003 = ~%value% penalty~ // reprise de @10000102

// Opcode 0 : types d'attaque, 20 001 000 + masque de parameter2 (20 001 000-20 001 015)
@20001001 = ~vs. crushing attacks~ // reprise de @10000001
@20001002 = ~vs. missile attacks~ // reprise de @10000002
@20001003 = ~vs. crushing and missile attacks~ // reprise de @10000003
@20001004 = ~vs. piercing attacks~ // reprise de @10000004
@20001005 = ~vs. crushing and piercing attacks~ // reprise de @10000005
@20001006 = ~vs. piercing and missile attacks~ // reprise de @10000006
@20001007 = ~vs. crushing, piercing and missile attacks~ // reprise de @10000007
@20001008 = ~vs. slashing attacks~ // reprise de @10000008
@20001009 = ~vs. crushing and slashing attacks~ // reprise de @10000009
@20001010 = ~vs. slashing and missile attacks~ // reprise de @10000010
@20001011 = ~vs. crushing, slashing and missile attacks~ // reprise de @10000011
@20001012 = ~vs. slashing and piercing attacks~ // reprise de @10000012
@20001013 = ~vs. crushing, slashing and piercing attacks~ // reprise de @10000013
@20001014 = ~vs. slashing, piercing and missile attacks~ // reprise de @10000014

// Effet dérivé 001, AC_NO_PROTECTION : phrases (30 010 100-30 010 999)
@30010100 = ~No protection %versus%~ // reprise de @15210001

// Effet dérivé 003, ABILITIES : libellés (30 030 000-30 030 099)
@30030000 = ~Abilities~ // reprise de @15010001
