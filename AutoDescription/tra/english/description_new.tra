/*
 * Chaînes du nouveau moteur (new-lib/). Fichier en UTF-8 sans BOM ; uniquement des caractères
 * représentables en Windows-1252 (convertis pour les jeux classiques par HANDLE_CHARSETS).
 * Identifiants : 1 000 000-9 999 999 et 20 000 000-39 999 999 uniquement, selon le plan de
 * numérotation (.agents/tra-numbering.md). « reprise de @n » : texte identique à celui de
 * description.tra, vérifié par tools/static_checks.py.
 */

// Mise en forme : ponctuation et séparateurs (1 000 000-1 099 999)
@1000000 = ~
~ // reprise de @10000
@1000001 = ~: ~ // reprise de @10001
@1000002 = ~; ~ // reprise de @10004
@1000003 = ~%~ // reprise de @10022
@1000004 = ~and~ // reprise de @100021
@1000005 = ~, ~ // reprise de @10020
@1000006 = ~ %and% ~ // reprise de @10021
@1000007 = ~or~ // reprise de @100004

// Mise en forme : distances, 1 100 000 + pluriel + 2 × demi-unité ; le .tra choisit l'unité (%distance_units% mètres entiers, %distance_feet% pieds) (1 100 000-1 100 099)
@1100000 = ~%distance_feet% feet~
@1100001 = ~%distance_feet% feet~
@1100002 = ~%distance_feet% feet~
@1100003 = ~%distance_feet% feet~

// Mise en forme : valeurs (1 200 000-1 200 099)
@1200000 = ~%name%%AD_COLON%%value%~ // reprise de @100001
@1200001 = ~+%value%~ // reprise de @10003
@1200002 = ~Set to %value%~ // reprise de @10010
@1200003 = ~%value%%~ // reprise de @10002
@1200004 = ~Multiplied by %value%~ // reprise de @10006
@1200005 = ~%diceCount%d%diceSides%~ // reprise de @10014
@1200006 = ~Fixed at %value%~
@1200010 = ~%name%%AD_COLON%%value%~ // reprise de @100001
@1200011 = ~%name% %ofTheTarget%%AD_COLON%%value%~ // reprise de @100007

// Mise en forme : phrases des modificateurs simples, séries de 10 (+0 soi, +1 cible…) : 0110 augmentation, 0120 réduction (1 210 000-1 210 999)
@1210111 = ~Increases %theStatistic% %ofTheTarget% by %value%~ // reprise de @102286
@1210112 = ~to increase %theStatistic% %ofTheTarget% by %value%~ // reprise de @102544
@1210113 = ~to increase %theStatistic% %ofTheTarget% by %value%~ // reprise de @102544
@1210121 = ~Reduces %theStatistic% %ofTheTarget% by %value%~ // reprise de @102285
@1210122 = ~to reduce %theStatistic% %ofTheTarget% by %value%~ // reprise de @102543
@1210123 = ~to reduce %theStatistic% %ofTheTarget% by %value%~ // reprise de @102543

// Mise en forme : titres de sections (1 300 000-1 300 099)
@1300000 = ~STATISTICS~ // reprise de @100003
@1300001 = ~Equipped abilities~ // reprise de @100010
@1300002 = ~Requires~ // reprise de @101032
@1300003 = ~Combat abilities~ // reprise de @100011
@1300004 = ~Charge abilities~ // reprise de @100012
@1300005 = ~Charge ability~ // reprise de @100015
@1300006 = ~Ability %abilityNumber%~ // reprise de @101124

// Mise en forme : expressions régulières d'analyse des descriptions d'origine (1 900 000-1 900 099)
@1900000 = ~^[ %TAB%]*\(CARACTÉRISTIQUES\|Caractéristiques\|CARACTERISTIQUES\|PARAMETRES\|PARAMÈTRES\|STATISTIQUES\|CAPACITES SPECIALES\|CAPACITES DE COMBAT\|Capacité de combat\|Capacités spéciales\|Capacité d'équipement\|Capacités d'équipement\|Capacités de charge\|Capacités de combat\|Poids\|Weight\|Statistics\|EIGENSCHAFTEN\|STATISTICHE\|Caratteristiche\|SPEZIELLE EIGENSCHAFTEN\)+\(.*[%MNL%%LNL%%WNL%]*\)*~ // reprise de @10008

// Cibles, 2 000 000 + 10 × cible effective de l'effet + forme (0 sujet, 1 « de… », 2 « à… ») (2 000 000-2 000 099)
@2000020 = ~the target~ // reprise de @102471
@2000021 = ~of the target~ // reprise de @101085
@2000022 = ~to the target~ // reprise de @101181
@2000050 = ~the non-group creatures~ // reprise de @101191
@2000051 = ~of the non-group creatures~ // reprise de @101192
@2000052 = ~to the non-group creatures~ // reprise de @101193
@2000100 = ~the wearer~ // reprise de @102472
@2000101 = ~of the wearer~ // reprise de @101086
@2000102 = ~to the wearer~ // reprise de @101180
@2000110 = ~the drinker~ // reprise de @102451
@2000111 = ~of the drinker~ // reprise de @102452
@2000112 = ~to the drinker~ // reprise de @102453

// Cibles d'une zone nommées d'après le projectile : 2 001 000 + 10 × créatures visées (0 toutes, 1 hostiles, 2 alliées) + forme (0 sujet, 1 « de… », 2 « à… ») ; 2 001 100 zone, 2 001 102 cône (2 001 000-2 001 199)
@2001000 = ~the creatures~ // reprise de @102700
@2001001 = ~of creatures~ // reprise de @102710
@2001002 = ~to creatures~ // reprise de @102720
@2001010 = ~the enemies~ // reprise de @102701
@2001011 = ~of enemies~ // reprise de @102711
@2001012 = ~to enemies~ // reprise de @102721
@2001020 = ~the allies~ // reprise de @102702
@2001021 = ~of allies~ // reprise de @102712
@2001022 = ~to allies~ // reprise de @102722
@2001100 = ~%target% within a radius of %range%~ // reprise de @102800
@2001102 = ~%target% within a %range% cone on a %angle%° arc~ // reprise de @102802

// Durées : formules (3 000 000-3 000 099)
@3000000 = ~for %strDuration%~ // reprise de @100311
@3000001 = ~permanently~ // reprise de @100312
@3000002 = ~permanently, persists after death~ // reprise de @100313
